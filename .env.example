# All VITE_* values are public browser configuration, never private secrets.
# Supply the read API you control; the old deployment URL is not trusted by default.
VITE_READ_API_URL=
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
VITE_SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
VITE_MARKET_ID=1
# Keep disabled until the deployed program, IDL and endpoints are independently verified.
VITE_ENABLE_TRANSACTIONS=false
VITE_VERIFIED_PROGRAM_ID=
