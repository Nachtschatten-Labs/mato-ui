# All VITE_* values are public browser configuration, never private secrets.
# Mainnet SOL/USDC market data.
VITE_READ_API_URL=https://read-api-production-f8ea.up.railway.app
# For a dedicated mainnet RPC, put SOLANA_RPC_URL and SOLANA_WS_URL in .dev.vars.
# See DEVELOPMENT.md. Provider credentials stay in server-only Worker bindings.
VITE_MARKET_ID=1
# Local development and preview builds are read-only. Enable trading only in a verified production build.
VITE_ENABLE_TRANSACTIONS=false
VITE_VERIFIED_PROGRAM_ID=TwobwMYkKbT8uMWqgPrEPXTPoyYsKAPmaWun6T2WT4A
