# All VITE_* values are public browser configuration, never private secrets.
# Supply the read API you control; the old deployment URL is not trusted by default.
VITE_READ_API_URL=
# Server-only provider endpoints; run pnpm rpc:prepare for local production preview.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
VITE_MARKET_ID=1
# Enable only after the operator accepts the deployed program and matching IDL.
VITE_ENABLE_TRANSACTIONS=false
VITE_VERIFIED_PROGRAM_ID=
