{
  "name": "mato-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "security:source": "node scripts/check-source.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check": "pnpm security:source && pnpm typecheck && pnpm test && pnpm build:preview",
    "build:preview": "vite build --mode preview",
    "deploy:preview": "pnpm check && wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "cf:typegen": "wrangler types --include-runtime false",
    "deploy:production": "pnpm security:source && pnpm typecheck && pnpm test && pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@solana/client": "1.7.0",
    "@solana/kit": "6.5.0",
    "@solana/program-client-core": "6.5.0",
    "@solana/react-hooks": "1.4.1",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "1.168.49",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lightweight-charts": "5.2.1",
    "lucide-react": "0.577.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.129.0"
  }
}
