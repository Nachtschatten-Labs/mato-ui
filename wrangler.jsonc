{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mato-ui-preview",
  "account_id": "a47cdd329426d3fe463b84d562f36f45",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
  "env": {
    "production": {
      "name": "mato-ui",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "mato.markets",
          "custom_domain": true,
        },
      ],
    },
  },
}
